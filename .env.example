# Copy this file to .env for local dev with `vercel dev`
# In production, set these in Vercel dashboard → Settings → Environment Variables

# ── Required: pick ONE API provider ──────────────────────────────────────────

# Option A — NVIDIA NIM
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key-here

# Option B — DeepSeek
# Get your key at: https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Option C — OpenAI
# Get your key at: https://platform.openai.com
# OPENAI_API_KEY=sk-your-openai-key-here

# Option D — GitHub Models (GPT-5)
# Use a GitHub token with Models read access
# OPENAI_API_KEY=your-github-token
# API_BASE_URL=https://models.github.ai/inference
# AI_MODEL=openai/gpt-5

# ── Optional overrides ────────────────────────────────────────────────────────

# Override the model (NVIDIA defaults to z-ai/glm-5.2)
# AI_MODEL=z-ai/glm-5.2

# Override the API base URL (useful for other OpenAI-compatible providers)
# API_BASE_URL=https://integrate.api.nvidia.com/v1
