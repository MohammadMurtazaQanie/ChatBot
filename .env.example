# Copy this file to .env for local dev with `vercel dev`
# In production, set these in Vercel dashboard → Settings → Environment Variables

# ── Required ─────────────────────────────────────────────────────────────────

# Google Gemini API key
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional overrides ────────────────────────────────────────────────────────

# Override the Gemini model (defaults to models/gemini-3.6-flash)
# Accepts a bare id or a full resource name.
# AI_MODEL=models/gemini-3.6-pro
